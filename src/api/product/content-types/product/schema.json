{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "price": {
      "type": "decimal"
    },
    "description": {
      "type": "blocks"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "hasCAD": {
      "type": "boolean",
      "default": false
    },
    "category": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::category.category",
      "mappedBy": "product"
    },
    "tutorials": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tutorial.tutorial",
      "mappedBy": "products"
    },
    "order_logs": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::order-log.order-log",
      "inversedBy": "products"
    }
  }
}
