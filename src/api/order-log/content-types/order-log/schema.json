{
  "kind": "collectionType",
  "collectionName": "order_logs",
  "info": {
    "singularName": "order-log",
    "pluralName": "order-logs",
    "displayName": "OrderLog"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "orderId": {
      "type": "string",
      "required": true
    },
    "timestamp": {
      "type": "datetime"
    },
    "products": {
      "type": "json"
    },
    "totalPrice": {
      "type": "decimal"
    },
    "isResgisteredUser": {
      "type": "boolean",
      "default": false
    },
    "users_permissions_user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "order_log"
    }
  }
}
